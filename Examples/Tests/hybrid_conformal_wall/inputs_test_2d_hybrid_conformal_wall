# Hybrid conformal (ECT) embedded-boundary wall: a rotated-square PEC block
# centered in a periodic 2D (XZ) domain, uniform By, drifting cold ions kept
# a standoff off the wall. The analysis asserts the constitutive PEC closure
# (E and J exactly zero deep in the conductor) and field boundedness.
max_step = 3
warpx.const_dt = 5.e-10

amr.n_cell = 32 32
amr.max_grid_size = 16
amr.blocking_factor = 8
amr.max_level = 0

geometry.dims = 2
geometry.prob_lo = -0.8 -0.8
geometry.prob_hi =  0.8  0.8

boundary.field_lo = periodic periodic
boundary.field_hi = periodic periodic
boundary.particle_lo = periodic periodic
boundary.particle_hi = periodic periodic

my_constants.theta = pi/8
my_constants.ahalf = 0.25
warpx.eb_implicit_function = "xr=x*cos(theta)+z*sin(theta); zr=-x*sin(theta)+z*cos(theta); (ahalf - max(abs(xr),abs(zr)))"

algo.maxwell_solver = hybrid
algo.particle_shape = 1
algo.current_deposition = direct

hybrid_pic_model.elec_temp = 1.0
hybrid_pic_model.n0_ref = 1e18
hybrid_pic_model.gamma = 1.0
hybrid_pic_model.n_floor = 1e14
hybrid_pic_model.plasma_resistivity(rho,J) = 1e-4
hybrid_pic_model.substeps = 4
hybrid_pic_model.use_conformal_eb = 1

warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = 0. 0.02 0.

particles.species_names = ions
ions.charge = q_e
ions.mass = m_p
ions.injection_style = NUniformPerCell
ions.num_particles_per_cell_each_dim = 1 1
ions.profile = parse_density_function
ions.density_function(x,y,z) = "xr=x*cos(pi/8)+z*sin(pi/8); zr=-x*sin(pi/8)+z*cos(pi/8); 1e18*(max(abs(xr),abs(zr))>(0.25+0.10))"

ions.momentum_distribution_type = constant
ions.ux = 0.
ions.uy = 0.
ions.uz = 1e-4

diagnostics.diags_names = diag1
diag1.diag_type = Full
diag1.intervals = 3
diag1.format = plotfile
diag1.fields_to_plot = Ex Ey Ez Bx By Bz jx jy jz
diag1.plot_raw_fields = 1
